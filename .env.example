# LLM Provider (Groq)
GROQ_API_KEY=your_groq_api_key_here
LLM_MODEL=llama-3.3-70b-versatile
LLM_TEMPERATURE=0.0

# Vector Database (Pinecone)
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=retrieva
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# Embedding Model (HuggingFace / Local)
HUGGINGFACEHUB_API_TOKEN=your_huggingfacehub_api_token_here
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
DENSE_EMBEDDINGS_PATH=./data/dense_embeddings.npy

# Retrieval Configuration
RETRIEVER_TYPE=hybrid        # Options: hybrid, semantic, bm25
HYBRID_ALPHA=0.3             # 0.0 = pure BM25, 1.0 = pure semantic vector, 0.3 = optimal balanced on benchmark
TOP_K=4                      # Number of documents to retrieve
RRF_K=60                     # Reciprocal Rank Fusion constant

# Cross-Encoder Reranker (Phase 2)
RERANK_ENABLED=false
RERANK_CANDIDATES=20         # Top candidates retrieved from hybrid search before reranking
RERANKER_MODEL=BAAI/bge-reranker-base

# Query Rewriting & Multi-Query Expansion (Phase 3)
QUERY_MODE=none              # Options: none, rewrite, multi
QUERY_REWRITE_MODEL=llama-3.3-70b-versatile
QUERY_REWRITE_TIMEOUT=2.5    # Fallback to original query if LLM call exceeds 2.5s
MULTI_QUERY_VARIANTS=3       # Number of expanded query variants to fuse via RRF

# Caching & MLOps
ENABLE_CACHE=true
CACHE_BACKEND=redis          # Options: redis, memory
CACHE_TTL_SECONDS=3600
CACHE_MAX_SIZE=1000
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
PROMETHEUS_METRICS_PATH=/metrics

# Service Ports
API_PORT=8000
FRONTEND_PORT=8501
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
